# Stellar Network Configuration
NETWORK=local
RPC_URL=http://localhost:8000/soroban/rpc
HORIZON_URL=http://localhost:8000

# Stellar credit assets / Soroswap hardening
USDC_ISSUER=G...
EURC_ISSUER=G...
SOROSWAP_API=https://api.soroswap.finance/quote
# Required to enable Soroswap quote fallback; pin the exact reviewed C... router.
SOROSWAP_CONTRACT_ID=C...

# Deployer Key (for contract deployment and SBT admin)
DEPLOYER_SECRET=S...
DEPLOYER_PUBLIC=G...

# Contract IDs (populated after deployment)
SBT_CONTRACT_ID=C...
TREE_CONTRACT_ID=C...
VOTING_CONTRACT_ID=C...
BRIDGE_CONTRACT_ID=C...

# Tree Configuration
TREE_DEPTH=18

# Backend Relayer Configuration (required for anonymous voting)
RELAYER_SECRET_KEY=S...  # Relayer account private key (pays tx fees)
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE=Standalone Network ; February 2017
PORT=3001

# Future: Launchtube integration (planned for mainnet)
# LAUNCHTUBE_URL=https://launchtube.stellar.org
# LAUNCHTUBE_TOKEN=your_token_here

# Vault Secrets Manager (optional - enables dynamic secret retrieval)
# When set, the backend will fetch RELAYER_SECRET_KEY, RELAYER_AUTH_TOKEN,
# and PINATA_JWT from Vault instead of environment variables.
# VAULT_URL=https://vault.example.com:8200
# VAULT_TOKEN=your_vault_token
# VAULT_ROLE_ID=your_role_id (for AppRole auth)
# VAULT_SECRET_ID=your_secret_id (for AppRole auth)
# VAULT_MOUNT_PATH=secret (default: secret)
# VAULT_SECRETS_PATH=kv/data/zkvote (default: secret/data/zkvote)

# Optional: Proof Query Service (indexes on-chain events)
PROOF_SERVICE_PORT=3000

# Testing
TEST_USER_SECRET=S...
TEST_USER_PUBLIC=G...
