/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# ZK circuit artifacts (vote.wasm, *_final.zkey, verification_key.json) are
# static build output that only changes when the circuit is recompiled and
# published under a new /circuits/<version>/ path (see circuit-registry.ts
# on the backend). Safe to cache aggressively at the CDN edge and in the
# browser (see #192).
/circuits/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
