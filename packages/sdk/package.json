{
  "name": "@zkvote/sdk",
  "version": "1.0.0",
  "description": "ZKVote Proving SDK - Zero-knowledge proof generation and verification",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "workers",
    "manifests",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "zero-knowledge",
    "zk-snark",
    "groth16",
    "voting",
    "privacy",
    "stellar",
    "soroban"
  ],
  "author": "ZKVote Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZK-VOTE/ZK-VOTE.git",
    "directory": "packages/sdk"
  },
  "dependencies": {
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
