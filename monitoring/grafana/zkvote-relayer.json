{
  "title": "ZKVote Relayer",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [{ "name": "job", "type": "query", "query": "label_values(zkvote_http_requests_total, job)", "includeAll": true, "multi": true, "current": { "text": "All", "value": ["$__all"] } }] },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Request rate", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "targets": [{ "expr": "sum(rate(zkvote_http_requests_total{job=~\"$job\"}[5m]))", "legendFormat": "requests/sec" }] },
    { "id": 2, "type": "timeseries", "title": "5xx error rate", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "targets": [{ "expr": "sum(rate(zkvote_http_requests_total{job=~\"$job\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(zkvote_http_requests_total{job=~\"$job\"}[5m])), 1)", "legendFormat": "error ratio" }] },
    { "id": 3, "type": "timeseries", "title": "HTTP p95 latency", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(zkvote_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])))", "legendFormat": "p95" }] },
    { "id": 4, "type": "timeseries", "title": "RPC errors", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "targets": [{ "expr": "sum by (method) (rate(zkvote_rpc_errors_total{job=~\"$job\"}[5m]))", "legendFormat": "{{method}}" }] },
    { "id": 5, "type": "timeseries", "title": "Indexer lag", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }, "targets": [{ "expr": "zkvote_indexer_lag_ledgers{job=~\"$job\"}", "legendFormat": "ledgers" }] },
    { "id": 6, "type": "timeseries", "title": "Database write health", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }, "targets": [{ "expr": "zkvote_db_write_healthy{job=~\"$job\"}", "legendFormat": "healthy" }] },
    { "id": 7, "type": "timeseries", "title": "Security & Isolation Denials", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }, "targets": [{ "expr": "sum by (reason) (rate(zkvote_unauthenticated_rejection_total{job=~\"$job\"}[5m]))", "legendFormat": "unauthenticated: {{reason}}" }, { "expr": "sum by (reason) (rate(zkvote_cross_tenant_denial_total{job=~\"$job\"}[5m]))", "legendFormat": "cross-tenant: {{reason}}" }] },
    { "id": 8, "type": "timeseries", "title": "Reconciliation Mismatches", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }, "targets": [{ "expr": "sum by (component, mismatch_type) (rate(zkvote_reconciliation_mismatch_total{job=~\"$job\"}[5m]))", "legendFormat": "{{component}} - {{mismatch_type}}" }] },
    { "id": 9, "type": "timeseries", "title": "Batch Partial Failures", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 }, "targets": [{ "expr": "sum by (batch_type, reason) (rate(zkvote_batch_partial_failure_total{job=~\"$job\"}[5m]))", "legendFormat": "{{batch_type}}: {{reason}}" }] },
    { "id": 10, "type": "timeseries", "title": "Session & Rate Limit Store Size", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 }, "targets": [{ "expr": "zkvote_session_store_size{job=~\"$job\"}", "legendFormat": "sessions" }, { "expr": "zkvote_rate_limit_store_size{job=~\"$job\"}", "legendFormat": "rate limit keys" }] }
  ]
}
